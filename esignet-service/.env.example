# ─────────────────────────────────────────────────────────────────────────────
# esignet-service environment variables
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# The Makefile automatically loads .env when present.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP / ThunderID engine ───────────────────────────────────────────────────
# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info
PORT=8080
ISSUER_URL=http://127.0.0.1:8080
DATA_DIR=./data
SIGNING_KEY_PATH=./keys/signing.key

# Authentication provider: catalog (local users) or mosip (MOSIP IDA)
AUTHN_PROVIDER=catalog

# Used by `make smoke` (defaults to ISSUER_URL when unset)
# BASE_URL=http://127.0.0.1:8080

# ── MOSIP IDA authentication ──────────────────────────────────────────────────
# Common API host; endpoint URLs are derived from this and MOSIP_LICENSE_KEY
# unless overridden individually below.
MOSIP_API_BASE_URL=https://api-internal.test.mosip.net
MOSIP_LICENSE_KEY=sample-license-key

# IDA request metadata (domainUri defaults to MOSIP_API_BASE_URL; env defaults to Staging)
# MOSIP_DOMAIN_URI=https://api-internal.test.mosip.net
# MOSIP_ENV=Staging

# Optional full URL overrides (leave commented to use MOSIP_API_BASE_URL defaults)
# MOSIP_IDA_PARTNER_CERT_URL=https://api-internal.test.mosip.net/mosip-certs/ida-partner.cer
# MOSIP_SEND_OTP_BASE_URL=https://api-internal.test.mosip.net/idauthentication/v1/otp/<license-key>/
# MOSIP_KYC_AUTH_BASE_URL=https://api-internal.test.mosip.net/idauthentication/v1/kyc-auth/delegated/<license-key>/
# MOSIP_KYC_EXCHANGE_BASE_URL=https://api-internal.test.mosip.net/idauthentication/v1/kyc-exchange/delegated/<license-key>/

# Partner keystore for request signing (required for MOSIP auth flows)
MOSIP_P12_PATH=./sample-partner-keystore.p12
MOSIP_P12_PASSWORD=add-p12-password-here

# ── Client-management (POST /v1/esignet/client-mgmt/client) ───────────────────
#
# DB env-var names match the MOSIP helm chart's extraEnvVars block exactly
# (see deploy/esignet/values.yaml). In production, K8s injects these from:
#   - ConfigMap "postgres-config"     → DATABASE_HOST / PORT / NAME / USERNAME
#   - Secret    "db-common-secrets"   → DB_DBUSER_PASSWORD
# For local dev, set them here in .env. DB_DBUSER_PASSWORD is REQUIRED; the
# binary refuses to start without it (safer than connecting empty-passworded).

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mosip_esignet
DATABASE_USERNAME=esignetuser
DB_DBUSER_PASSWORD=esignetpwd
DATABASE_SSLMODE=disable
DATABASE_SCHEMA=esignet

# Pool sizing (defaults shown):
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_TIMEOUT=5s

# Regex bounding clientId / relyingPartyId. Empty → `^\S+$` (one or more
# non-whitespace chars). Tighten per deployment if needed.
# CLIENT_SUPPORTED_ID_REGEX=^[A-Za-z0-9._:@\-]+$

# Optional override for the additionalConfig sub-schema. Empty uses the
# embedded schema. Accepts http, https, or file URLs.
# CLIENT_ADDITIONAL_CONFIG_SCHEMA_URL=

# ── Supported-list policy (REQUIRED) ──────────────────────────────────────────
# Comma-separated allow-lists used by the create-request validator. These are
# MOSIP policy, not engine capability — matches the Java esignet pattern (see
# application-default.properties: mosip.esignet.supported.*). The binary
# refuses to start if any of these four are unset.
CLIENT_SUPPORTED_USER_CLAIMS=name,given_name,family_name,middle_name,nickname,preferred_username,profile,picture,website,gender,birthdate,zoneinfo,locale,updated_at,email,email_verified,phone_number,phone_number_verified,address
CLIENT_SUPPORTED_ACR_VALUES=mosip:idp:acr:generated-code,mosip:idp:acr:static-code,mosip:idp:acr:linked-wallet,mosip:idp:acr:biometrics,mosip:idp:acr:knowledge,mosip:idp:acr:password
CLIENT_SUPPORTED_GRANT_TYPES=authorization_code,refresh_token
CLIENT_SUPPORTED_CLIENT_AUTH_METHODS=private_key_jwt

# ── Helm chart hint (production K8s) ──────────────────────────────────────────
# Add this block to deploy/esignet/values.yaml's extraEnvVars to wire the
# Go service to the existing postgres-config ConfigMap and db-common-secrets
# Secret on every MOSIP cluster — no new K8s objects needed.
#
# extraEnvVars: |
#   - name: DATABASE_HOST
#     valueFrom:
#       configMapKeyRef: { name: postgres-config,    key: database-host }
#   - name: DATABASE_PORT
#     valueFrom:
#       configMapKeyRef: { name: postgres-config,    key: database-port }
#   - name: DATABASE_NAME
#     valueFrom:
#       configMapKeyRef: { name: postgres-config,    key: database-name }
#   - name: DATABASE_USERNAME
#     valueFrom:
#       configMapKeyRef: { name: postgres-config,    key: database-username }
#   - name: DB_DBUSER_PASSWORD
#     valueFrom:
#       secretKeyRef:    { name: db-common-secrets,  key: db-dbuser-password }
#   - name: DATABASE_SSLMODE
#     value: require
#   - name: CLIENT_SUPPORTED_USER_CLAIMS
#     value: "name,given_name,family_name,email,email_verified,phone_number,phone_number_verified,address"
#   - name: CLIENT_SUPPORTED_ACR_VALUES
#     value: "mosip:idp:acr:biometrics,mosip:idp:acr:linked-wallet,mosip:idp:acr:generated-code"
#   - name: CLIENT_SUPPORTED_GRANT_TYPES
#     value: "authorization_code,refresh_token"
#   - name: CLIENT_SUPPORTED_CLIENT_AUTH_METHODS
#     value: "private_key_jwt"
